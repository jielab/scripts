# OS roots are supplied by ../0f/0os.sh before this file is loaded.
# Explicit environment variables and CLI arguments take precedence.
# Permanent inputs stay under DIR_DATA; HPC products default to dated scratch.
ALLELE_ANALYSIS_ROOT=${ALLELE_ANALYSIS_ROOT:-${ANALYSIS_ROOT:-/mnt/d/analysis}/allele3}
ALLELE_SCAN_STORE=${ALLELE_SCAN_STORE:-${DIR_DATA:-/mnt/f}/annot/gnomad/allele3}
ALLELE_VCF_DIR=${ALLELE_VCF_DIR:-${DIR_DATA:-/mnt/f}/annot/gnomad/sites}
ALLELE_ANCIENT_DIR=${ALLELE_ANCIENT_DIR:-${DIR_DATA:-/mnt/f}/gen/ancient}
ALLELE_ARCHAIC_ROOT=${ALLELE_ARCHAIC_ROOT:-${DIR_DATA:-/mnt/f}/analysis/gu}
ALLELE_ARCHAIC_DATASETS=${ALLELE_ARCHAIC_DATASETS:-1kg}
ALLELE_ARCHAIC_LIFTOVER=${ALLELE_ARCHAIC_LIFTOVER:-${DIR_SOFTWARE:-/mnt/d/software}/bin/liftOver}
ALLELE_METADATA=${ALLELE_METADATA:-$ALLELE_ANCIENT_DIR/allele3/pca3d/metadata/sample_metadata.tsv}
ALLELE_COORDINATES=${ALLELE_COORDINATES:-$ALLELE_ANCIENT_DIR/allele3/pca3d/pca/all.sscore}
ALLELE_COHORT_TABLE=${ALLELE_COHORT_TABLE:-${DIR_DATA:-/mnt/f}/gen/1kg/38/allele3/herv_cohort/herv_cohort_burden.tsv}
ALLELE_FASTA=${ALLELE_FASTA:-${DIR_DATA:-/mnt/f}/gen/1hgp/38/GRCH38.fasta.gz}
ALLELE_FASTA37=${ALLELE_FASTA37:-${DIR_DATA:-/mnt/f}/gen/1hgp/37/GRCH37.fasta.gz}
ALLELE_CHAIN38TO37=${ALLELE_CHAIN38TO37:-${DIR_DATA:-/mnt/f}/gen/chains/hg38ToHg19.over.chain.gz}
ALLELE_CHAIN37TO38=${ALLELE_CHAIN37TO38:-${DIR_DATA:-/mnt/f}/gen/chains/hg19ToHg38.over.chain.gz}
ALLELE_LD_BLOCK_DIR=${ALLELE_LD_BLOCK_DIR:-${DIR_DATA:-/mnt/f}/LD/block}
ALLELE_ERV_JOINED=${ALLELE_ERV_JOINED:-${DIR_DATA:-/mnt/f}/annot/allele3/repeats/hg38/rmskJoinedCurrent.txt.gz}
ALLELE_LOW_MAPPABILITY_BED=${ALLELE_LOW_MAPPABILITY_BED:-${OS_FILES_ROOT:-/mnt/d/files}/allele3/umap/hg38.k100.lt1.bed.gz}
# The annot/1kg files may be sites-only. Individual VCF defaults remain separate;
# actual sample/GT headers must be checked before overriding this location.
ALLELE_1KG_VCF_DIR=${ALLELE_1KG_VCF_DIR:-${DIR_DATA:-/mnt/f}/gen/1kg/38/vcf}
ALLELE_1KG_PANEL=${ALLELE_1KG_PANEL:-${DIR_DATA:-/mnt/f}/gen/1kg/38/samples.txt}
ALLELE_ALL_OF_US=${ALLELE_ALL_OF_US:-${DIR_DATA:-/mnt/f}/annot/allele3/allofus/hg38_allofus.txt.gz}
ALLELE_ATLAS_DIR=${ALLELE_ATLAS_DIR:-${DIR_DATA:-/mnt/f}/annot/allele3/alphagenome/hg38}
ALLELE_MEMORY_LIMIT_GB=${ALLELE_MEMORY_LIMIT_GB:-${ALLELE_ALLOCATED_MEMORY_GIB:-16}}

PCA3D_COMMAND=${PCA3D_COMMAND:-run}
PCA3D_REPLACE=${PCA3D_REPLACE:-TRUE}
PCA3D_ANALYSIS_ROOT=${PCA3D_ANALYSIS_ROOT:-$ALLELE_ANALYSIS_ROOT}
PCA3D_ANCIENT_DIR=${PCA3D_ANCIENT_DIR:-$ALLELE_ANCIENT_DIR}
PCA3D_PGEN_PREFIX=${PCA3D_PGEN_PREFIX:-$ALLELE_ANCIENT_DIR/AncientDNA_plus_EUR1KG_AllVariants_NoQC_GRCh37_autosomes}
PCA3D_HQ_VARIANTS=${PCA3D_HQ_VARIANTS:-$ALLELE_ANCIENT_DIR/HighQualityVariants.tsv}
PCA3D_METADATA=${PCA3D_METADATA:-$ALLELE_METADATA}
PCA3D_EIGENVEC=${PCA3D_EIGENVEC:-$ALLELE_COORDINATES}
PCA3D_REUSE_BASIS=${PCA3D_REUSE_BASIS:-$ALLELE_ANCIENT_DIR/allele3/pca3d/pca}
if [[ ${submit:-local} == hpc ]]; then
    PCA3D_PLINK2=${PCA3D_PLINK2:-plink2}
else
    PCA3D_PLINK2=${PCA3D_PLINK2:-${DIR_DATA:-/mnt/f}/software/allele3/plink2-20261024/plink2}
fi
PCA3D_PROJECT_BASIS=${PCA3D_PROJECT_BASIS:-$ALLELE_ANCIENT_DIR/allele3/pca3d/pca_projection_unique}
PCA3D_PROJECT_INFO=${PCA3D_PROJECT_INFO:-${DIR_DATA:-/mnt/f}/gen/ukb/37/allele3/pca_projection/ukb_info.tsv.gz}
PCA3D_PROJECT_TARGET_GLOB=${PCA3D_PROJECT_TARGET_GLOB:-${DIR_DATA:-/mnt/f}/gen/ukb/37/imp/chr[0-9]*.pgen}

# FASTA is resolved after --build is parsed, so --build 37 never inherits 38.
HERV_BUILD=${HERV_BUILD:-38}
HERV_LIBRARY=${HERV_LIBRARY:-${DIR_DATA:-/mnt/f}/annot/allele3/dfam_4.0_human/human.curated.fa}
HERV_REPLACE=${HERV_REPLACE:-TRUE}
ALLELE_SCAN_REPLACE=${ALLELE_SCAN_REPLACE:-TRUE}
# Reuse remains explicit for legacy recalculation: --replace FALSE.
