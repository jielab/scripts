# Dataset results and analysis inputs live on F:; integrated reports stay on D:.
ALLELE_ANALYSIS_ROOT=${ALLELE_ANALYSIS_ROOT:-/mnt/d/analysis/allele3}
ALLELE_SCAN_STORE=${ALLELE_SCAN_STORE:-/mnt/f/annot/gnomad/allele3}
ALLELE_ARCHAIC_ROOT=${ALLELE_ARCHAIC_ROOT:-/mnt/f/analysis/gu}
# Start with 1kg; use --archaic-datasets to add selected UKB cohorts later.
ALLELE_ARCHAIC_DATASETS=${ALLELE_ARCHAIC_DATASETS:-1kg}
ALLELE_METADATA=${ALLELE_METADATA:-/mnt/f/gen/ancient/allele3/pca3d/metadata/sample_metadata.tsv}
ALLELE_COORDINATES=${ALLELE_COORDINATES:-/mnt/f/gen/ancient/allele3/pca3d/pca/all.sscore}
ALLELE_COHORT_TABLE=${ALLELE_COHORT_TABLE:-/mnt/f/gen/1kg/38/allele3/herv_cohort/herv_cohort_burden.tsv}

# The default PCA command recalculates from raw PGEN and supplementary metadata.
# Historical coordinates are used only by explicit render/atlas/trajectory.
PCA3D_COMMAND=${PCA3D_COMMAND:-run}
PCA3D_REPLACE=${PCA3D_REPLACE:-TRUE}
PCA3D_ANALYSIS_ROOT=${PCA3D_ANALYSIS_ROOT:-$ALLELE_ANALYSIS_ROOT}
PCA3D_METADATA=${PCA3D_METADATA:-$ALLELE_METADATA}
PCA3D_EIGENVEC=${PCA3D_EIGENVEC:-$ALLELE_COORDINATES}
PCA3D_REUSE_BASIS=${PCA3D_REUSE_BASIS:-/mnt/f/gen/ancient/allele3/pca3d/pca}
# Target-specific exclusions are optional; standalone PCA has no dependency on
# a previous integrated analysis. Supply --target-variants explicitly if needed.
PCA3D_PLINK2=${PCA3D_PLINK2:-/mnt/f/software/allele3/plink2-20261024/plink2}

# External projection uses an independent coordinate-unique derivative; render
# continues to read the original historical coordinates above.
PCA3D_PROJECT_BASIS=${PCA3D_PROJECT_BASIS:-/mnt/f/gen/ancient/allele3/pca3d/pca_projection_unique}
PCA3D_PROJECT_INFO=${PCA3D_PROJECT_INFO:-/mnt/f/gen/ukb/37/allele3/pca_projection/ukb_info.tsv.gz}
PCA3D_PROJECT_TARGET_GLOB=${PCA3D_PROJECT_TARGET_GLOB:-'/mnt/f/gen/ukb/37/imp/chr[0-9]*.pgen'}

# HERV input/output paths are resolved after --dat/--gen, --build and --sample:
# /mnt/f/gen/DAT/BUILD/herv/SAMPLE. A separate HERV_REUSE_DIR remains optional.
HERV_BUILD=${HERV_BUILD:-38}

# Default personal-HERV and scan invocations now recalculate (user preference).
# PCA/scan accept their explicit F: output paths; previous products are archived.
HERV_REPLACE=${HERV_REPLACE:-TRUE}
ALLELE_SCAN_REPLACE=${ALLELE_SCAN_REPLACE:-TRUE}
# Reuse remains explicit: 2.herv.sh --replace FALSE; 3.scan.sh verify.
