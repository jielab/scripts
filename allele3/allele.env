# shellcheck shell=bash
# Local settings. CLI arguments override these defaults. Secrets stay external.
ALLELE_PYTHON=${ALLELE_PYTHON:-/home/huangj/anaconda3/envs/allele3-evolution/bin/python3}
ALLELE_ANALYSIS_ROOT=${ALLELE_ANALYSIS_ROOT:-/mnt/d/analysis/allele3}
ALLELE_VCF_DIR=${ALLELE_VCF_DIR:-/mnt/f/annot/gnomad/sites}
ALLELE_FASTA=${ALLELE_FASTA:-/mnt/f/gen/1hgp/38/GRCH38.fasta.gz}
ALLELE_ANCIENT_DIR=${ALLELE_ANCIENT_DIR:-/mnt/f/gen/ancient}
ALLELE_MEMORY_LIMIT_GB=${ALLELE_MEMORY_LIMIT_GB:-16}
ALLELE_JOBS=${ALLELE_JOBS:-2}

# Optional AlphaGenome: used only with --with-atlas or atlas-query.
ALLELE_API_KEY_FILE=${ALLELE_API_KEY_FILE:-/mnt/d/files/alphaG.api}

# Verified input copies on the Linux filesystem speed up repeated PGEN reads.
# Scientific outputs remain under ALLELE_ANALYSIS_ROOT on D:.
ALLELE_PGEN_CACHE_DIR=${ALLELE_PGEN_CACHE_DIR:-$HOME/.cache/allele3-evolution/pgen}

# FINAL 2026-10-22: dedicated outputs; the previous evolution pilot stays intact.
ALLELE_LOCAL_OUT=${ALLELE_LOCAL_OUT:-$ALLELE_ANALYSIS_ROOT/final/gnomad_local}
ALLELE_MODERN_OUT=${ALLELE_MODERN_OUT:-$ALLELE_LOCAL_OUT}
ALLELE_EVOLUTION_OUT=${ALLELE_EVOLUTION_OUT:-$ALLELE_ANALYSIS_ROOT/final/evolution}
ALLELE_WITH_ARCHITECTURE=${ALLELE_WITH_ARCHITECTURE:-1}
ALLELE_WITH_UNIVERSES=${ALLELE_WITH_UNIVERSES:-1}
ALLELE_LD_BLOCK_DIR=${ALLELE_LD_BLOCK_DIR:-/mnt/f/LD/block}
ALLELE_ERV_JOINED=${ALLELE_ERV_JOINED:-/mnt/f/annot/repeats/hg38/rmskJoinedCurrent.txt.gz}
ALLELE_ANNOTATION_CACHE=${ALLELE_ANNOTATION_CACHE:-$ALLELE_ANALYSIS_ROOT/final/annotations}
ALLELE_UKB_MFI_DIR=${ALLELE_UKB_MFI_DIR:-/mnt/f/gen/ukb/37/imp_mfi}
ALLELE_U1_SITES=${ALLELE_U1_SITES:-20000}
ALLELE_U3_SITES=${ALLELE_U3_SITES:-3000}
ALLELE_MAX_VARIANTS=${ALLELE_MAX_VARIANTS:-9000}
ALLELE_METAG_CENSUS=${ALLELE_METAG_CENSUS:-/mnt/f/annot/herv_hg38_v1/census/genome_fraction.json}
