# Optional local overrides. Copy to local.runtime.env, edit, then source it.
# Public entry points already load f/runtime.env automatically.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/f/runtime.env"
export GU_CONDA_EXE="$GU_CONDA_BASE/bin/conda"
export GU_ENV_NAME=gu
export GU_ARCHAIC37_ROOT="$GU_REF_ROOT/archaic/37/vcf"
export IBDMIX_RUNTIME="$GU_SOFT/ibdmix"
export IBDMIX_PREPARE_BIN="$GU_SOFT/ibdmix-prepare/prepare"
export IBDMIX_GPU_BIN="$GU_SOFT/ibdmix-gpu/ibdmix-gpu"
export IBDMIX_MASK_ROOT="$GU_REF_ROOT/archaic/37/mask"
export IBDMIX_REFERENCE_FASTA="$GU_REF_ROOT/1hgp/37/GRCH37.fasta.gz"
export GU_REF_FASTA="$IBDMIX_REFERENCE_FASTA"
export UKB_REF_FASTA="$IBDMIX_REFERENCE_FASTA"
export TMPDIR=/tmp
export GU_RESOURCE_GUARD=auto
export ARG_RESOURCE_GUARD=auto
export GU_THREADS_ENV="$GU_SOFT/venvs/gu-threads"
export GU_SINGER_ENV="$GU_SOFT/venvs/gu-singer"
# export GU_THREADS_PYTHON=/absolute/path/to/python3.12
# export GU_NVCC=/usr/local/cuda/bin/nvcc
# export IBDMIX_HTSLIB_PREFIX="$CONDA_PREFIX"
# Optional exact-reference DAF BED, with required adjacent JSON provenance:
# export GU_IBDMIX_DAF_MASK=/absolute/path/to/Altai-DAF.bed
