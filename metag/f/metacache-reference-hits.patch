+// metag: ASCII JSON strings also escape the outer table separator.
+static void reference_json_string (std::ostream& os, const std::string& text)
+{
+    const char hex[] = "0123456789abcdef";
+    os << '"';
+    for (unsigned char c : text) {
+        if (c == '"' || c == '\\') os << '\\' << char(c);
+        else if (c < 32 || c == '|') os << "\\u00" << hex[c >> 4] << hex[c & 15];
+        else os << char(c);
+    }
+    os << '"';
+}
+
+void show_reference_hits (std::ostream& os, const taxonomy_cache& taxonomy,
+                          const span<const location> matches)
+{
+    std::map<target_id, std::size_t> counts;
+    for (const auto& hit : matches) ++counts[hit.tgt];
+    os << '[';
+    bool first = true;
+    for (const auto& entry : counts) {
+        const auto* tax = taxonomy.cached_taxon_of_target(entry.first);
+        if (!tax) continue;
+        if (!first) os << ',';
+        first = false;
+        os << '[';
+        reference_json_string(os, tax->name());
+        os << ',';
+        reference_json_string(os, tax->source().filename);
+        const auto* species = taxonomy.cached_ancestor(entry.first, taxon_rank::Species);
+        os << ',' << (species ? species->id() : 0) << ',' << entry.second << ']';
+    }
+    os << ']';
+}
