# Scientific tools for scheduled GWAS workers; planning remains lightweight.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)/0f/0os.sh"
if [[ $submit == hpc ]]; then
    unset R_HOME R_LIBS R_LIBS_USER R_LIBS_SITE
    export R_ENVIRON_USER=/dev/null R_PROFILE_USER=/dev/null
    export SAIGE_ENV_DIR=${SAIGE_ENV_DIR:-$DIR_WORK/.conda/envs/saige}
    export GWAS_LD_PYTHON=${GWAS_LD_PYTHON:-$DIR_WORK/.conda/envs/py311/bin/python3}
    export PATH="$DIR_WORK/.conda/envs/py311/bin:$DIR_WORK/.conda/envs/le8/bin:$DIR_SOFTWARE/bin:$PATH"
fi
