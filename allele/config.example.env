# Optional: copy to allele.env to override the built-in defaults.
ALLELE_ENV_NAME=allele
ALLELE_OUT=/mnt/d/analysis/allele
# Formal input: complete gnomAD v4.1 genome sites files; autosomes by default.
# A local 1KG pilot can override this with --vcf/--region.
ALLELE_VCF_DIR=/mnt/f/annot/gnomad
# gnomad_download.sh is independent: set its destination/proxy with --out/--proxy.
# Indexed BGZF FASTA; keep the adjacent .fai and .gzi files.
ALLELE_FASTA=/mnt/f/gen/1hgp/38/GRCH38.fasta.gz
# Required for `allele.sh atlas` and `allele.sh all`.
# The key itself stays outside scripts; this file stores only its path.
ALLELE_API_KEY_FILE=/mnt/d/files/alphaG.api

# Fixed-dimensional, signed AlphaGenome molecular-effect vector by default.
ALLELE_ATLAS_SCORERS=ATAC,DNASE,CHIP_TF,CHIP_HISTONE,CAGE,PROCAP
ALLELE_ATLAS_CHUNK=128
ALLELE_BIALLELIC_RATIO=2
ALLELE_SEED=20261015
