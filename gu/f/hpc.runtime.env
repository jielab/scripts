# Shared worker runtime (historical filename retained for saved commands).
GU_WORKER_CODE_ROOT=${GU_WORKER_CODE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
source "$GU_WORKER_CODE_ROOT/f/runtime.env"
PS1=${PS1-}
set +u
source "$GU_CONDA_BASE/etc/profile.d/conda.sh"
conda activate "$GU_ENV_PREFIX"
set -u
export PATH="$CONDA_PREFIX/bin:$DIR_SOFTWARE/bin:$PATH"
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib"
export BCFTOOLS_PLUGINS="$CONDA_PREFIX/libexec/bcftools"
export GU_ARCHAIC37_ROOT=${GU_ARCHAIC37_ROOT:-$GU_REF_ROOT/archaic/37/vcf}
export IBDMIX_RUNTIME=${IBDMIX_RUNTIME:-$GU_SOFT/ibdmix}
export IBDMIX_PREPARE_BIN=${IBDMIX_PREPARE_BIN:-$GU_SOFT/ibdmix-prepare/prepare}
export IBDMIX_HTSLIB_PREFIX=$CONDA_PREFIX
export IBDMIX_MASK_ROOT=${IBDMIX_MASK_ROOT:-$GU_REF_ROOT/archaic/37/mask}
export IBDMIX_REFERENCE_FASTA=${IBDMIX_REFERENCE_FASTA:-$GU_REF_ROOT/1hgp/37/GRCH37.fasta.gz}
export GU_REF_FASTA=${GU_REF_FASTA:-$IBDMIX_REFERENCE_FASTA}
export UKB_REF_FASTA=${UKB_REF_FASTA:-$IBDMIX_REFERENCE_FASTA}
if [[ $submit == hpc ]]; then
    export GU_RESOURCE_GUARD=scheduler ARG_RESOURCE_GUARD=scheduler
else
    export GU_RESOURCE_GUARD=${GU_RESOURCE_GUARD:-auto} ARG_RESOURCE_GUARD=${ARG_RESOURCE_GUARD:-auto}
fi
