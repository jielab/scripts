# gu-FINAL-HPC-2026.zip: copy to hpc.runtime.env and verify the software paths.
# Code deployment: /work/sph-huangj/scripts.HPC/
# All F-drive data are mirrored below /work/sph-huangj/data/.
# This file is sourced only inside jobs.
# gu-hpc.sh snapshots it into the run, so later edits do not change queued work.
# Use the queue assigned to your account: inspect `queueinfo` on the cluster.
# CPU-only workflow; no CUDA or GPU resources are requested.
export GU_CONDA_BASE="/work/sph-huangj/software/gu/conda"
export GU_CONDA_EXE="$GU_CONDA_BASE/bin/conda"
PS1="${PS1-}"
set +u  # Some conda activation hooks read optional unset variables.
source "$GU_CONDA_BASE/etc/profile.d/conda.sh"
conda activate gu
set -u
export GU_ENV_NAME=gu
export GU_CODE_ROOT="/work/sph-huangj/scripts.HPC"
export GU_DATA_ROOT="/work/sph-huangj/data"
export GU_REF_ROOT="/work/sph-huangj/data/gen"
export GU_ANNOT_ROOT="$GU_DATA_ROOT/annot"
export DATE_SCRATCH="${DATE_SCRATCH:-2026-10-31}"
export SCRATCH_ANALYSIS_ROOT="/scratch/$DATE_SCRATCH/sph-huangj/analysis"
export GU_ANALYSIS_BASE="${GU_ANALYSIS_BASE:-$SCRATCH_ANALYSIS_ROOT/gu}"
export GU_FILES_ROOT="$GU_DATA_ROOT/files"
export GU_SOFT="/work/sph-huangj/software/gu"
export GU_ARCHAIC37_ROOT="$GU_REF_ROOT/archaic/37/vcf"
export IBDMIX_RUNTIME="$GU_SOFT/ibdmix"
export IBDMIX_PREPARE_BIN="$GU_SOFT/ibdmix-prepare/prepare"
export IBDMIX_HTSLIB_PREFIX="$CONDA_PREFIX"
export IBDMIX_MASK_ROOT="$GU_REF_ROOT/archaic/37/mask"
export IBDMIX_AXT_DIR="$GU_ANNOT_ROOT/axt/37"
export IBDMIX_REFERENCE_FASTA="$GU_REF_ROOT/1hgp/37/GRCH37.fasta.gz"
export GU_REF_FASTA="$IBDMIX_REFERENCE_FASTA"
export UKB_REF_FASTA="$IBDMIX_REFERENCE_FASTA"
# Cross-build SNP coordinate panel. This was on the D drive, so it needs a
# separate copy if it was not included in the F-drive data mirror.
export CHECK_GRCH_SNP_LIST="/work/sph-huangj/data/ukb/common/snp.lst"
# Required only for analyses that lift hg38 COJO coordinates to hg19.
# The chain also originated on D: and must be copied separately.
export GU_COJO_CHAIN="$GU_FILES_ROOT/liftOver/hg38ToHg19.over.chain.gz"
export GU_LIFTOVER="/work/sph-huangj/software/bin/liftOver"
# Optional ARG runtimes installed by install.sh --arg.
export GU_THREADS_ENV="$GU_CONDA_BASE/envs/gu-threads"
export GU_SINGER_ENV="$GU_CONDA_BASE/envs/gu"
export GU_SINGER_HOME="$GU_SOFT/singer-0.1.9"
# Add the installed tool paths required by the selected workflow.
export PATH="$CONDA_PREFIX/bin:/work/sph-huangj/software/bin:$PATH"
# CPU scheduling is owned by LSF. Do not start local background supervisors.
export GU_RESOURCE_GUARD=scheduler
export ARG_RESOURCE_GUARD=scheduler
# Leave cohort-dependent filtering to gu.sh. A UKB cohort without AFR5 controls
# must not be treated as a full-population 1KG control design.

# Isolate GU from library paths inherited from unrelated project environments.
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib"
