# One configuration for local WSL and HPC; explicit exports take precedence.
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)/0f/0os.sh"
export GU_CODE_ROOT=${GU_CODE_ROOT:-$SCRIPTS_ROOT}
export GU_DATA_ROOT=${GU_DATA_ROOT:-$DIR_DATA}
export GU_REF_ROOT=${GU_REF_ROOT:-$GU_DATA_ROOT/gen}
export GU_ANNOT_ROOT=${GU_ANNOT_ROOT:-$GU_DATA_ROOT/annot}
export IBDMIX_AXT_DIR=${IBDMIX_AXT_DIR:-$OS_AXT_ROOT}
export GU_ANALYSIS_BASE=${GU_ANALYSIS_BASE:-$ANALYSIS_ROOT/gu}
export GU_SOFT=${GU_SOFT:-$DIR_SOFTWARE/gu}
export GU_CONDA_BASE=${GU_CONDA_BASE:-$OS_GU_CONDA}
export GU_FILES_ROOT=${GU_FILES_ROOT:-$OS_FILES_ROOT}
export CHECK_GRCH_SNP_LIST=${CHECK_GRCH_SNP_LIST:-$OS_SNP_LIST}
export GU_CONDA_EXE=${GU_CONDA_EXE:-$GU_CONDA_BASE/bin/conda}
export GU_ENV_NAME=${GU_ENV_NAME:-gu}
if [[ $submit == hpc ]]; then
    export GU_ENV_PREFIX=${GU_ENV_PREFIX:-$DIR_WORK/.conda/envs/$GU_ENV_NAME}
    # Qiming's V100 queue supports the CUDA caller; allow site/user overrides.
    export GU_GPU_QUEUE=${GU_GPU_QUEUE:-8v100-32-sc}
else
    export GU_ENV_PREFIX=${GU_ENV_PREFIX:-$GU_CONDA_BASE/envs/$GU_ENV_NAME}
fi
if [[ $submit == hpc ]]; then
    export GU_THREADS_PYTHON=${GU_THREADS_PYTHON:-$DIR_WORK/.conda/envs/le8/bin/python3}
    export GU_SINGER_PYTHON=${GU_SINGER_PYTHON:-$GU_ENV_PREFIX/bin/python3}
fi
export GU_THREADS_ENV=${GU_THREADS_ENV:-$GU_SOFT/venvs/qiming-threads}
export GU_SINGER_ENV=${GU_SINGER_ENV:-$GU_SOFT/venvs/qiming-singer}
export GU_SINGER_HOME=${GU_SINGER_HOME:-$GU_SOFT/singer-0.1.9}
export GU_COJO_CHAIN=${GU_COJO_CHAIN:-$GU_FILES_ROOT/liftOver/hg38ToHg19.over.chain.gz}
export GU_LIFTOVER=${GU_LIFTOVER:-$DIR_SOFTWARE/bin/liftOver}
export GRID_CONDA_ENV=${GRID_CONDA_ENV:-$GU_ENV_PREFIX}
export GRID_CACHE_ROOT=${GRID_CACHE_ROOT:-$GU_ANALYSIS_BASE/cache}
export GU_ASMC_BACKEND_ROOT=${GU_ASMC_BACKEND_ROOT:-$GU_SOFT/asmc-memory/v1.4.0-p2}

export GU_RESULTS_RSCRIPT=${GU_RESULTS_RSCRIPT:-$GU_ENV_PREFIX/bin/Rscript}
export RESULTS_RSCRIPT=${RESULTS_RSCRIPT:-$GU_RESULTS_RSCRIPT}
export RESULTS_PYTHON=${RESULTS_PYTHON:-$GU_ENV_PREFIX/bin/python3}
