# Validated AS3 environment.
export GU_CONDA_BASE=/home/huangj/anaconda3
export AS3_PYTHON=/home/huangj/anaconda3/envs/as3_mamba/bin/python
export AS3_PYTHON_VERSION=3.11
export AS3_TORCH_VERSION=2.8.0
export AS3_CUDA_VERSION=12.8
export AS3_TORCHVISION_VERSION=0.23.0

# AS3 process isolation. The target is chunked before inference, and each AS3
# Python child runs in its own cgroup so an unexpected spike cannot trigger a
# WSL-wide OOM that disrupts unrelated terminals.
export AS3_TARGET_CHUNK_SIZE=64
export AS3_MEMORY_HIGH=20G
export AS3_MEMORY_MAX=24G
export AS3_MEMORY_SWAP_MAX=8G

# Local reference paths.
export GU_ARCHAIC37_ROOT=/mnt/d/data.BIG/refGen/archaic/37/vcf
export AS3_REFERENCE_PANEL_DIR=/mnt/d/data.BIG/refGen/archaic/38/vcf
export AS3_REFERENCE_MAP=/mnt/d/data.BIG/refGen/archaic/38/vcf/Ref_Panel.map.txt
export AS3_MASK_DIR=/mnt/d/data.BIG/refGen/archaic/38/mask
export AS3_MODEL_DIR=/mnt/d/data.BIG/refGen/archaic/38/models
export GU_NORMALIZE_DIR=/mnt/d/analysis/gu/normalize
export AS3_REFERENCE_CALLSET_CACHE=/mnt/d/analysis/gu/normalize/reference-callsets.sqlite

# Published external callsets.
export AS3_PUBLISHED_CALLS_DIR=/mnt/d/data.BIG/refGen/archaic/38/database_introgression_call
